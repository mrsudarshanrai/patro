{
  "name": "patrojs",
  "version": "1.0.0-beta.6",
  "description": "React calendar and datepicker for Gregorian (AD) and Nepali Bikram Sambat (BS) dates, with AD ↔ BS conversion",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "utils": [
        "./dist/utils.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./style.css": "./dist/css/style.css",
    "./dist/css/style.css": "./dist/css/style.css",
    "./package.json": "./package.json"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrsudarshanrai/patro.git"
  },
  "bugs": {
    "url": "https://github.com/mrsudarshanrai/patro/issues"
  },
  "homepage": "https://patro.sudarshanrai.com.np",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf ./dist && rollup -c --bundleConfigAsCjs && npm run build:css",
    "dev": "rollup -c --bundleConfigAsCjs -w",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest && npm run test:tz",
    "test:tz": "node scripts/test-timezones.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm_config_dry_run=false npm run check:package && npm run check:size",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "build:css": "sass package/scss/style.scss dist/css/style.css --style=compressed --no-source-map",
    "check:package": "publint && attw --pack . --exclude-entrypoints style.css dist/css/style.css",
    "test:package": "node scripts/smoke-package.mjs",
    "check:size": "node scripts/check-size.mjs",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@headlessui/react": "^2.2.10",
    "@playwright/test": "^1.64.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.2.17",
    "@types/react-dom": "^18.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.63.5",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "sass": "^1.64.1",
    "storybook": "^10.6.0",
    "ts-jest": "^29.4.14",
    "tslib": "^2.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md,mjs}": [
      "prettier --write"
    ]
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@floating-ui/dom": "^1.8.0"
  },
  "keywords": [
    "nepali-calendar",
    "bikram-sambat",
    "nepali-date",
    "bs",
    "ad",
    "ad2bs",
    "bs2ad",
    "date-converter",
    "react",
    "datepicker",
    "date-picker",
    "date-range-picker",
    "calendar"
  ]
}
